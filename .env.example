# Backend HTTP origin. Only the Next.js server reads this value.
API_ORIGIN=http://localhost:4000
# Browser connects directly for Socket.IO; backend CORS must allow the web origin.
NEXT_PUBLIC_REALTIME_ORIGIN=http://localhost:4000
# Public, URL-restricted Mapbox token for browser maps and geocoding.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Server-only Google Places API (optional; Mapbox geocoding is the fallback).
GOOGLE_PLACES_API_KEY=
